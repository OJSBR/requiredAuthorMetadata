msgid "plugins.generic.requiredAuthorMetadata.displayName"
msgstr "Metadados obrigatórios de autoria"

msgid "plugins.generic.requiredAuthorMetadata.description"
msgstr "Permite à revista exigir a afiliação e a biografia de todos os autores e coautores, cada uma separadamente, e impedir a conclusão da submissão enquanto faltar alguma delas. Os gestores da revista e os editores de secção podem ficar isentos."

msgid "plugins.generic.requiredAuthorMetadata.settings.intro"
msgstr "Escolha o que esta revista exige dos autores e coautores de uma submissão. Nada é exigido enquanto nenhuma caixa for marcada aqui."

msgid "plugins.generic.requiredAuthorMetadata.settings.area.fields"
msgstr "Campos obrigatórios para todos os autores"

msgid "plugins.generic.requiredAuthorMetadata.settings.requireAffiliation"
msgstr "Afiliação (instituição)"

msgid "plugins.generic.requiredAuthorMetadata.settings.requireBiography"
msgstr "Resumo da biografia"

msgid "plugins.generic.requiredAuthorMetadata.settings.area.enforcement"
msgstr "Onde a exigência vale"

msgid "plugins.generic.requiredAuthorMetadata.settings.area.enforcement.description"
msgstr "Os campos acima são exigidos sempre que um autor é gravado. Aqui decide se a submissão incompleta ainda pode ser concluída e quem fica fora da regra."

msgid "plugins.generic.requiredAuthorMetadata.settings.requireOnSubmit"
msgstr "Impedir a conclusão da submissão enquanto faltar nalgum autor"

msgid "plugins.generic.requiredAuthorMetadata.settings.editorsExempt"
msgstr "Gestores da revista e editores de secção ficam isentos"

msgid "plugins.generic.requiredAuthorMetadata.error.affiliation.required"
msgstr "A afiliação é obrigatória para todos os autores nesta revista."

msgid "plugins.generic.requiredAuthorMetadata.error.biography.required"
msgstr "A biografia é obrigatória para todos os autores nesta revista."

msgid "plugins.generic.requiredAuthorMetadata.error.affiliation.onSubmit"
msgstr "A submissão não pode ser concluída enquanto faltar a afiliação de: {$names}."

msgid "plugins.generic.requiredAuthorMetadata.error.biography.onSubmit"
msgstr "A submissão não pode ser concluída enquanto faltar a biografia de: {$names}."
