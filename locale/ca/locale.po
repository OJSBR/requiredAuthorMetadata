msgid "plugins.generic.requiredAuthorMetadata.displayName"
msgstr "Metadades d'autoria obligatòries"


msgid "plugins.generic.requiredAuthorMetadata.settings.intro"
msgstr "Trieu què exigeix aquesta revista als autors i coautors d'una tramesa. No s'exigeix res mentre no es marqui cap casella aquí."

msgid "plugins.generic.requiredAuthorMetadata.settings.area.fields"
msgstr "Camps obligatoris per a tots els autors"

msgid "plugins.generic.requiredAuthorMetadata.settings.requireAffiliation"
msgstr "Afiliació (institució)"

msgid "plugins.generic.requiredAuthorMetadata.settings.requireBiography"
msgstr "Resum biogràfic"

msgid "plugins.generic.requiredAuthorMetadata.settings.area.enforcement"
msgstr "On s'aplica l'exigència"

msgid "plugins.generic.requiredAuthorMetadata.settings.area.enforcement.description"
msgstr "Els camps anteriors s'exigeixen cada vegada que es desa un autor. Aquí decidiu si una tramesa incompleta encara es pot completar i qui queda fora de la regla."

msgid "plugins.generic.requiredAuthorMetadata.settings.requireOnSubmit"
msgstr "Impedir que es completi la tramesa mentre falti en algun autor"

msgid "plugins.generic.requiredAuthorMetadata.settings.editorsExempt"
msgstr "Els gestors de la revista i els editors de secció queden exempts"

msgid "plugins.generic.requiredAuthorMetadata.error.affiliation.required"
msgstr "L'afiliació és obligatòria per a tots els autors en aquesta revista."

msgid "plugins.generic.requiredAuthorMetadata.error.biography.required"
msgstr "La biografia és obligatòria per a tots els autors en aquesta revista."

msgid "plugins.generic.requiredAuthorMetadata.error.affiliation.onSubmit"
msgstr "La tramesa no es pot completar mentre falti l'afiliació de: {$names}."

msgid "plugins.generic.requiredAuthorMetadata.error.biography.onSubmit"
msgstr "La tramesa no es pot completar mentre falti la biografia de: {$names}."

msgid "plugins.generic.requiredAuthorMetadata.settings.requireFamilyName"
msgstr "Cognoms"

msgid "plugins.generic.requiredAuthorMetadata.error.familyName.required"
msgstr "Els cognoms són obligatoris per a tots els autors en aquesta revista."

msgid "plugins.generic.requiredAuthorMetadata.error.familyName.onSubmit"
msgstr "La tramesa no es pot completar mentre falten els cognoms de: {$names}."

msgid "plugins.generic.requiredAuthorMetadata.description"
msgstr "Permet a la revista exigir els cognoms, l'afiliació i la biografia de tots els autors i coautors, cadascun per separat, i impedir que es completi la tramesa mentre en falti algun. Els gestors de la revista i els editors de secció poden quedar-ne exempts."
